DATABASE_URL="file:./dev.db"

# https://authjs.dev/getting-started/installation#auth-secret
AUTH_SECRET=""

# Public origin of the deployment, e.g. https://unlocked.example.com.
# Auth.js builds the OAuth callback URL from it; the Discord app must have
# "<AUTH_URL>/api/auth/callback/discord" registered as a redirect URI.
AUTH_URL=""

# Discord OAuth app: https://discord.com/developers/applications
# Redirect URI to register there: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Where proof photos/videos are written. Relative paths resolve against the
# working directory; point this at a persistent volume on the VPS.
UPLOAD_DIR="uploads"

# Optional: `npm run db:seed` promotes this account to platform admin.
# The account must have signed in through Discord at least once.
BOOTSTRAP_ADMIN_EMAIL=""

# ---------------------------------------------------------------------------
# Deployment — only the VPS `.env`, next to compose.yaml, needs what follows.
# DATABASE_URL, UPLOAD_DIR and AUTH_URL are set by the compose file there:
# the first two point into the /data volume, the third is derived from DOMAIN.
# ---------------------------------------------------------------------------

# Image published by the CD workflow. Pin a commit tag to roll back:
# ghcr.io/<owner>/<repo>:<sha>
IMAGE="ghcr.io/<owner>/<repo>:latest"

# Domain Caddy issues a certificate for, and serves the app on. Its DNS A/AAAA
# record must already point at the VPS or the ACME challenge fails.
DOMAIN="unlocked.example.com"
