// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Domain model derived from docs/FEATURES.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) adapter models — https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Credentials login. Null for Discord-only accounts.
  username     String? @unique
  passwordHash String?

  // Platform-wide admin (manages categories/templates, global moderation).
  // Independent from any per-group role.
  isPlatformAdmin Boolean @default(false)

  accounts Account[]
  sessions Session[]

  memberships          GroupMember[]
  ownedGroups          Group[]          @relation("GroupOwner")
  createdAchievements  Achievement[]    @relation("AchievementCreator")
  targetedAchievements Achievement[]    @relation("AchievementTarget")
  estimationVotes      EstimationVote[]
  completions          Completion[]
  validationVotes      ValidationVote[]
  messages             Message[]
  createdBets          Bet[]
  wagers               Wager[]
  candidateOutcomes    BetOutcome[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Shared invite link/code — the only way to join (no public directory).
  inviteCode  String   @unique
  // Optional per-group Discord webhook receiving the plain-text activity log.
  discordWebhookUrl String?
  createdAt   DateTime @default(now())

  ownerId String
  owner   User   @relation("GroupOwner", fields: [ownerId], references: [id])

  members      GroupMember[]
  achievements Achievement[]
  activities   Activity[]
}

// Membership carries the per-group currencies: karma (score) and tokens
// (betting currency) are never global — see docs/FEATURES.md.
model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  karma    Int      @default(0)
  tokens   Int      @default(0)
  joinedAt DateTime @default(now())
  // Last time this member was called out for inactivity, so the reminder
  // fires once per period instead of on every page load.
  lastInactivityNudgeAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// ---------------------------------------------------------------------------
// Categories & templates (platform-admin owned)
// ---------------------------------------------------------------------------

// Fixed list, only platform admins can create/edit. Not user-provided tags.
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  achievements Achievement[]
  templates    AchievementTemplate[]
}

// Reusable achievement blueprint maintained by platform admins; instantiating
// one into a group skips the community point-estimation vote.
model AchievementTemplate {
  id          String   @id @default(cuid())
  title       String
  description String
  mode        String
  points      Int
  durationDays Int
  createdAt   DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  achievements Achievement[]
}

// ---------------------------------------------------------------------------
// Achievements
// ---------------------------------------------------------------------------

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String

  // "OPEN"     — competition, anyone in the group may attempt, ranked points.
  // "PERSONAL" — targets one named member, binary yes/no outcome.
  mode String

  // "ESTIMATING" — member-created, point-estimation vote still open
  // "ACTIVE"     — points settled, attempts accepted until deadline
  // "RESOLVED"   — deadline passed, or PERSONAL achievement validated
  // "CANCELLED"  — creator withdrew it before any submission
  status String @default("ACTIVE")

  // Null while status is ESTIMATING; settled from the vote, or fixed directly
  // when created by a platform admin / group owner.
  basePoints Int?

  // Only set while an estimation vote is running.
  estimationClosesAt DateTime?

  deadline  DateTime
  createdAt DateTime  @default(now())
  // Soft delete — moderation by author, group owner, or platform admin.
  deletedAt DateTime?

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("AchievementCreator", fields: [creatorId], references: [id])

  // PERSONAL mode only: the member the achievement is about.
  targetUserId String?
  targetUser   User?   @relation("AchievementTarget", fields: [targetUserId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  templateId String?
  template   AchievementTemplate? @relation(fields: [templateId], references: [id])

  estimationVotes EstimationVote[]
  completions     Completion[]
  messages        Message[]
  bet             Bet?
}

// One vote per member on what an achievement should be worth, when it was
// created by a regular member (admin/owner-created ones skip this).
model EstimationVote {
  id        String   @id @default(cuid())
  points    Int
  createdAt DateTime @default(now())

  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([achievementId, userId])
}

// A "Je l'ai fait" submission: the dedicated action carrying mandatory proof,
// distinct from thread messages. Submitting opens the validation vote.
model Completion {
  id       String  @id @default(cuid())
  proofUrl String
  note     String?

  // "PENDING" | "VALIDATED" | "REJECTED"
  status String @default("PENDING")

  // Points actually credited once validated (base × rank multiplier, or 0 when
  // the group voted it worthless). Null until resolved.
  awardedPoints Int?
  // 1-based arrival order among validated completions (OPEN mode ranking).
  rank          Int?

  voteClosesAt DateTime
  submittedAt  DateTime  @default(now())
  resolvedAt   DateTime?

  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  votes ValidationVote[]
}

model ValidationVote {
  id String @id @default(cuid())

  // "VALIDATE" | "REJECT" — rejecting means the proof is invalid/fraudulent,
  // which is different from validating with 0 points.
  decision String
  // Points the voter thinks it is worth; 0 is a valid "free achievement" vote.
  points   Int?

  createdAt DateTime @default(now())

  completionId String
  completion   Completion @relation(fields: [completionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([completionId, userId])
}

// Free-form discussion thread attached to an achievement. Images here are just
// illustration — official proof goes through Completion.
model Message {
  id        String    @id @default(cuid())
  body      String
  imageUrl  String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Bets — always attached to an achievement, always auto-resolved
// ---------------------------------------------------------------------------

model Bet {
  id String @id @default(cuid())

  // "YES_NO" for PERSONAL achievements, "WHO" for OPEN ones — derived from the
  // achievement's mode, never chosen independently.
  type String

  // "OPEN" | "RESOLVED" | "REFUNDED"
  status String @default("OPEN")

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  achievementId String @unique
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  winningOutcomeId String?     @unique
  winningOutcome   BetOutcome? @relation("WinningOutcome", fields: [winningOutcomeId], references: [id])

  outcomes BetOutcome[] @relation("BetOutcomes")
  wagers   Wager[]
}

model BetOutcome {
  id    String @id @default(cuid())
  label String

  betId String
  bet   Bet    @relation("BetOutcomes", fields: [betId], references: [id], onDelete: Cascade)

  // WHO bets: the candidate this outcome backs. Null for YES_NO outcomes.
  candidateId String?
  candidate   User?   @relation(fields: [candidateId], references: [id])

  wagers   Wager[]
  wonBy    Bet?    @relation("WinningOutcome")
}

model Wager {
  id     String @id @default(cuid())
  amount Int
  // Tokens returned at resolution: full pot share when won, stake when the bet
  // was refunded, 0 when lost. Null while the bet is still open.
  payout Int?

  createdAt DateTime @default(now())

  betId String
  bet   Bet    @relation(fields: [betId], references: [id], onDelete: Cascade)

  outcomeId String
  outcome   BetOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One position per member per bet.
  @@unique([betId, userId])
}

// ---------------------------------------------------------------------------
// Activity log — powers the in-app feed and the Discord webhook
// ---------------------------------------------------------------------------

model Activity {
  id        String   @id @default(cuid())
  // Plain-text line, already rendered ("Paul a validé « Courir 10km »").
  message   String
  createdAt DateTime @default(now())
  // Whether the line was successfully pushed to the group's Discord webhook.
  pushedToDiscord Boolean @default(false)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
}
